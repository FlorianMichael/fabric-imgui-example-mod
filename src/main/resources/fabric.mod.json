{
	"schemaVersion": 1,
	"id": "modid",
	"version": "${version}",
	"name": "Example ImGui mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://github.com/florianreuth/",
		"sources": "https://github.com/florianreuth/fabric-imgui-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/modid/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "de.florianreuth.imguiexample.ExampleMod"
		]
	},
	"mixins": [
		"modid.mixins.json"
	],
	"accessWidener": "modid.accesswidener",
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*",
		"imguimc": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}